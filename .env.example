# Where the SQLite file lives. Defaults to ./bot.db; on a host, point it at a
# persistent disk (e.g. /var/data/bot.db) or links are lost on every restart.
DATABASE_PATH=

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Set when registering the webhook (setWebhook's secret_token param) —
# echoed back by Telegram on every update, verified in main.py.
TELEGRAM_WEBHOOK_SECRET=change-me

# Shared with devtrack-backend: it signs /start deep-link tokens with this,
# this service verifies them. Same value must be set on both sides.
TELEGRAM_LINK_SECRET=change-me

# Shared with devtrack-backend: it authenticates its /send, /notify, /status, /link
# calls to this service with this key — and this service authenticates its calls to
# the backend's telegram/bot/ API with the same key.
BOT_SERVICE_API_KEY=change-me

# Where the DevTrack backend lives (the bot reads and changes tasks through it).
BACKEND_URL=http://localhost:8000

# Where the web app lives. Only a public https URL turns into "Open" buttons in
# messages (Telegram rejects localhost links); leave empty locally.
FRONTEND_URL=

# This service's own public https URL. When set, the webhook is registered with
# Telegram automatically on start-up. Leave empty for local development
# (use `python poll.py` instead).
PUBLIC_URL=
